#include <windows.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DROUTE_FILE_VERSION
 PRODUCTVERSION DROUTE_FILE_VERSION
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "snowluwu"
            VALUE "FileDescription", "SOCKS5 Support for Discord"
            VALUE "FileVersion", DROUTE_FILE_VERSION_STRING
            VALUE "InternalName", "droute"
            VALUE "OriginalFilename", "droute.dll"
            VALUE "ProductName", "Droute"
            VALUE "ProductVersion", DROUTE_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
